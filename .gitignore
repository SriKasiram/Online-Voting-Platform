# Secrets and keys: never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
keys/
# SR-02: the electoral roll signing keys (scripts/sign_roll.py). Also covered by keys/ and *.pem above.
# SR-11: the ballot encryption key, backend/keys/ballot.key (scripts/gen_ballot_key.py), lives here too.
backend/keys/
# SR-10: the development TLS certificate and its private key (python -m scripts.dev_certs)
certs/
# SR-12: ballot-side exports (python -m scripts.export_ballots) and server log files (LOG_DIR)
exports/
logs/
# SR-13: signed ballot chain checkpoints (CHECKPOINT_DIR). The checkpoint keys are under keys/ above.
checkpoints/
# SR-18: signed House result releases (RELEASES_DIR). The results keys are under keys/ above.
releases/
# SR-19: the availability monitor's probe logs (scripts/availability_monitor.py)
monitoring/
# SR-20: encrypted database backups (BACKUPS_DIR, scripts/backup_db.py). The backup key is under keys/ above.
backups/

# Databases and dumps
*.sqlite
*.sqlite3
*.dump
*.sql.gz
pgdata/

# Node and frontend build output
node_modules/
frontend/dist/
coverage/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
