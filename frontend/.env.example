# Optional. Copy to .env to change these. Names only, never put real secrets here.

# Length of a voting session in minutes. The voter is warned 1 minute before
# it ends and can choose Keep voting to start a new full session.
# Keep it equal to SESSION_MINUTES in backend/.env.
VITE_SESSION_MINUTES=10

# SR-15: when a finished or abandoned session is reset to the start screen, on every device.
# Seconds without input before the "Are you still there?" warning (5 to 600).
VITE_IDLE_SECONDS=90
# Seconds the warning stays up before the reset (5 to 120). 90 + 30 = 120 seconds in all.
VITE_IDLE_WARNING_SECONDS=30
# Seconds the receipt screen stays up (5 to 120). Keep it equal to POST_BALLOT_SESSION_SECONDS
# in backend/.env.
VITE_RECEIPT_SECONDS=60
# Milliseconds the reset waits for the logout request (500 to 3000).
VITE_RESET_LOGOUT_TIMEOUT_MS=3000
# SR-15: lower values are only for recording a demo quickly. No value turns the reset off: a
# missing, invalid, zero or negative value uses the default, and others are clamped to the range.
# These are built into the app, so run npm run build again after changing them.

# Where the dev server forwards /api requests (the FastAPI backend).
# SR-10: the backend listens only on HTTPS (TLS 1.3). Start the dev server with
# NODE_EXTRA_CA_CERTS=../certs/dev-cert.pem so its proxy trusts the certificate.
VITE_API_TARGET=https://localhost:8443
