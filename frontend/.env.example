# Copy to .env to change these. Names only, never put real secrets here.

# true  = use built-in fake data, no backend needed
# false = call the FastAPI backend under /api
VITE_USE_MOCK=true

# Length of a voting session in minutes. The voter is warned 1 minute before
# it ends and can choose Keep voting to start a new full session.
VITE_SESSION_MINUTES=10

# Where the dev server forwards /api requests (real mode only)
VITE_API_TARGET=http://localhost:8000
