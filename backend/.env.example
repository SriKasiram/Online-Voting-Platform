# Copy to .env and set your own password. Never commit .env.
# docker compose also reads this file when it first creates the local database.

# PostgreSQL connection. USER, PASSWORD and DB also set up the Docker database.
POSTGRES_USER=evoting
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=evoting
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and
# each connection can stall for up to 30 seconds
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Separate database for pytest. It is dropped and rebuilt on every test run,
# so its name must end in _test.
POSTGRES_TEST_DB=evoting_test

# How long a signed-in session lasts, in minutes. Keep it equal to
# VITE_SESSION_MINUTES in frontend/.env.
# SR-04: fixed from issue. Activity never lengthens it.
SESSION_MINUTES=10
# SR-04: explicit extensions per sign in, each with a new identifier (2 = 30 minutes at most)
MAX_SESSION_EXTENSIONS=2
# SR-04: seconds the session survives after a ballot is accepted
POST_BALLOT_SESSION_SECONDS=60

# SR-01: sign-in lockout. Failed attempts (password or code) in a row before
# the account locks, and for how many minutes.
MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=15
# SR-01: minutes allowed between the password step and the code step
# SR-04: lowered from 5 to 2
MFA_PENDING_MINUTES=2
# SR-01: sign-in requests allowed per client IP in each window
RATE_LIMIT_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=300
# SR-01: marks the session cookie Secure.
# SR-10: the app now runs only over HTTPS (https://localhost:8443), so keep it true.
COOKIE_SECURE=true

# SR-10: HSTS max-age in seconds. HSTS is remembered per host and ignores the port,
# so a long value would lock localhost to HTTPS in the browser; the code default is one year
HSTS_MAX_AGE=300
# SR-10: the TLS certificate and key that python -m app.serve uses, relative to the
# project root. python -m scripts.dev_certs creates these two. Never commit certs/.
# TLS_CERT_FILE=certs/dev-cert.pem
# TLS_KEY_FILE=certs/dev-key.pem
# SR-10: the single HTTPS port for the API and the built frontend (no plaintext port)
# SERVER_PORT=8443

# SR-02: the Ed25519 public key that checks electoral roll signatures. Leave it
# unset to use backend/keys/roll_public.pem, which python -m scripts.sign_roll
# (and the seed script) creates. The private key never belongs on the API server.
# ROLL_PUBLIC_KEY_PATH=
# SR-02: minimum age on the election's polling date
MIN_VOTING_AGE=18

# SR-12: BALLOT_TOKEN_MINUTES is gone (a per-token expiry was a time on the ballot side).
# A ballot token is usable while its election is open and the elector is signed in.

# SR-12: folder for the server's log files, if you save its output to files. The
# separation audit (python -m scripts.audit_separation) scans it. Default: logs/ at
# the project root, which .gitignore keeps out of Git.
# LOG_DIR=

# SR-13: the ballot hash chain (python -m scripts.seal_ballots / verify_chain).
# Paths are relative to backend/. A batch smaller than MIN_SEAL_BATCH is sealed
# only with --final, after polls close.
MIN_SEAL_BATCH=10
# One signed checkpoint file per election; stands in for separate storage. Never committed.
CHECKPOINT_DIR=checkpoints
# python -m scripts.gen_checkpoint_key creates both. The server side reads only the
# public key (and only to verify); the private key is for the seal script alone.
CHECKPOINT_PUBLIC_KEY=keys/checkpoint_public.pem
CHECKPOINT_PRIVATE_KEY=keys/checkpoint_private.pem

# SR-07: the ballot definition delegates' public keyring. Leave it unset to use
# backend/keys/delegates/keyring.json, which python -m scripts.ballot_definition
# (and the seed) creates with development keys.
# DELEGATE_KEYRING_PATH=
# SR-07: distinct delegates who must sign a ballot definition
REQUIRED_DELEGATE_APPROVALS=2
# SR-07: hours before polls open by which a definition must be activated
MIN_ACTIVATION_LEAD_HOURS=24

# SR-11: the 32-byte AES-256 key that encrypts every stored ballot. Leave it unset to
# use backend/keys/ballot.key, which python -m scripts.gen_ballot_key creates (0600).
# There is no default key: the API refuses to start without this file. Back it up
# separately from the database; losing it makes every stored ballot unreadable.
# Never commit it (keys/ is in .gitignore).
# BALLOT_KEY_FILE=

# Root secret for field encryption and keyed hashes, at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes every encrypted field and enrolment code unreadable, so
# reseed the database afterwards (python -m scripts.seed --reset).
SECRET_KEY=
