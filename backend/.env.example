# Copy to .env and set your own password. Never commit .env.
# docker compose also reads this file when it first creates the local database.

# PostgreSQL connection. USER, PASSWORD and DB also set up the Docker database.
POSTGRES_USER=evoting
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=evoting
# 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 first and
# each connection can stall for up to 30 seconds
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Separate database for pytest. It is dropped and rebuilt on every test run,
# so its name must end in _test.
POSTGRES_TEST_DB=evoting_test

# How long a signed-in session lasts, in minutes. Keep it equal to
# VITE_SESSION_MINUTES in frontend/.env.
SESSION_MINUTES=10

# SR-01: sign-in lockout. Failed attempts (password or code) in a row before
# the account locks, and for how many minutes.
MAX_FAILED_ATTEMPTS=5
LOCK_MINUTES=15
# SR-01: minutes allowed between the password step and the code step
MFA_PENDING_MINUTES=5
# SR-01: sign-in requests allowed per client IP in each window
RATE_LIMIT_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=300
# SR-01: marks the session cookie Secure. false here only because the local
# demo runs on http://localhost. Leave it unset (true) anywhere served over HTTPS.
COOKIE_SECURE=false

# SR-02: the Ed25519 public key that checks electoral roll signatures. Leave it
# unset to use backend/keys/roll_public.pem, which python -m scripts.sign_roll
# (and the seed script) creates. The private key never belongs on the API server.
# ROLL_PUBLIC_KEY_PATH=
# SR-02: minimum age on the election's polling date
MIN_VOTING_AGE=18

# SR-03: minutes a ballot token stays usable after it is issued
BALLOT_TOKEN_MINUTES=10

# Root secret for field encryption and keyed hashes, at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it makes every encrypted field and enrolment code unreadable, so
# reseed the database afterwards (python -m scripts.seed --reset).
SECRET_KEY=
